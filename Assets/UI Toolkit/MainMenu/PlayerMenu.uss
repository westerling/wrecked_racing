:root {
}

.playerCard {
    width: 200px;
    height: 680px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}

.playerContainer {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 10px;
    width: 100%;
    height: auto;
    align-content: flex-start;
    align-self: auto;
}
